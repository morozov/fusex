# Maintainer: Sergei Morozov <morozovby@gmail.com>

pkgname=fusex
pkgver=1.9.2.fusex.0.1.r53.gec38ed63
pkgrel=1
pkgdesc="ZX Spectrum emulator: the speccytools fork of Fuse, with the GTK 3 UI and libfusex"
arch=('x86_64')
url="https://github.com/speccytools/fusex"
license=('GPL-2.0-or-later')
depends=('gtk3' 'glib2' 'libxml2' 'libpng' 'zlib' 'bzip2' 'audiofile' 'alsa-lib')
makedepends=('git' 'autoconf' 'automake' 'libtool' 'pkgconf' 'perl')
provides=('libfusex.so')
conflicts=('fuse-emulator')

# The libfusex link relinks the program objects into a shared object by hand
# (ui/null/Makefile.am all-local); LTO objects do not survive that.
options=('!lto')

# Packaged from the checkout this PKGBUILD lives in, at whatever branch is
# checked out there. Override with FUSEX_REPO=/path/to/fusex makepkg.
_repo="${FUSEX_REPO:-$(cd "${startdir:-.}/../.." && pwd)}"

source=("$pkgname::git+file://$_repo")
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/$pkgname"
  git describe --long --tags | sed 's/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  cd "$srcdir/$pkgname"

  git config submodule.3rdparty/libspectrum.url "$_repo/3rdparty/libspectrum"
  git -c protocol.file.allow=always submodule update --init 3rdparty/libspectrum

  # The program installs as fusex; the desktop entry and completion name it.
  sed -i 's/^Exec=fuse@FUSE_BIN_EXTENSION@ /Exec=fusex@FUSE_BIN_EXTENSION@ /' \
         data/org.speccytools.FuseX.desktop.in
  sed -i 's/^complete -F _fuse -o filenames fuse$/complete -F _fuse -o filenames fusex/' \
         data/shell-completion/bash/fuse

  ./autogen.sh
  cd 3rdparty/libspectrum && ./autogen.sh
}

build() {
  # A shared libspectrum records its install path, which nothing outside this
  # build dir can resolve; both the binary and libfusex absorb the archive
  # instead, so the package carries no libspectrum at all. --with-pic is what
  # makes the archive linkable into libfusex.so.
  cd "$srcdir/$pkgname/3rdparty/libspectrum"
  ./configure --prefix="$srcdir/dist" \
              --disable-shared --with-pic --without-libgcrypt
  make
  make install

  # A libspectrum package installed on the build host would otherwise win the
  # linker's search: configure emits -L/usr/lib ahead of the pkg-config path,
  # and an older libspectrum there fails the link on symbols this tree needs.
  export PKG_CONFIG_PATH="$srcdir/dist/lib/pkgconfig"
  export CPPFLAGS="-I$srcdir/dist/include${CPPFLAGS:+ $CPPFLAGS}"
  export LDFLAGS="-L$srcdir/dist/lib${LDFLAGS:+ $LDFLAGS}"

  # A source tree holds one configuration, so each UI gets its own build dir.
  # --without-pthread disables Spectranet, whose SSH offload would otherwise
  # hard-require prebuilt mbedtls/libssh2 archives in 3rdparty/dist.
  mkdir -p "$srcdir/$pkgname/build-gtk"
  cd "$srcdir/$pkgname/build-gtk"
  ../configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var \
               --with-gtk --without-pthread \
               --program-transform-name='s/^fuse$/fusex/' \
               --enable-desktop-integration \
               --with-bash-completion-dir=/usr/share/bash-completion/completions
  make

  # Any null-UI build also produces libfusex.so as a side effect of all-local.
  mkdir -p "$srcdir/$pkgname/build-null"
  cd "$srcdir/$pkgname/build-null"
  ../configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var \
               --with-null-ui --without-pthread --with-audio-driver=null
  make
}

check() {
  cd "$srcdir/$pkgname/build-null"
  # check-local links roms/ into the build dir but not the lib/tests fixtures
  # the unit tests open relative to the working directory.
  ln -sfn ../lib lib
  make check
}

package() {
  make -C "$srcdir/$pkgname/build-gtk" DESTDIR="$pkgdir" install

  # libfusex has no install rule of its own.
  install -Dm755 "$srcdir/$pkgname/build-null/libfusex.so" \
                 "$pkgdir/usr/lib/libfusex.so"

  mv "$pkgdir/usr/share/bash-completion/completions/fuse" \
     "$pkgdir/usr/share/bash-completion/completions/fusex"
}
